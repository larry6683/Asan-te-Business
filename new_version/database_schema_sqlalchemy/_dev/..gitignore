# ============================================
# Database Layer - .gitignore
# ============================================

# ===========================================
# Python
# ===========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/

# ===========================================
# Environment & Configuration
# ===========================================
# Development environment files
_dev/.env
_dev/.env.local
_dev/.env.*.local

# Keep template
!_dev/template.env

# Database connection configs
database.json
db-config.json
connection-string.txt

# ===========================================
# Database Files
# ===========================================
# SQLite databases (if used for testing)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Database dumps and backups
*.sql.backup
*.dump
*.backup
backups/
dumps/

# Migration backups
migrations/backups/
migrations/*.backup.sql

# ===========================================
# Docker Volumes & Data
# ===========================================
# Docker volume data directories
_dev/postgres-data/
_dev/pgadmin-data/
_dev/volumes/

# Docker override files
_dev/docker-compose.override.yml

# ===========================================
# Scripts Output
# ===========================================
# Script output and logs
scripts/output/
scripts/logs/
scripts/temp/

# Seed data backups
scripts/seed_data/backup/
scripts/seed_data/*.backup

# ===========================================
# Generated Files
# ===========================================
# Alembic autogenerated migrations (if used)
alembic/versions/*.pyc
alembic/__pycache__/

# SQLAlchemy model cache
.model_cache/

# ===========================================
# Logs
# ===========================================
logs/
*.log
*.log.*
migration.log
populate.log
setup.log

# Service logs
postgres.log
pgadmin.log

# ===========================================
# Testing
# ===========================================
.pytest_cache/
.coverage
htmlcov/
test-results/
.hypothesis/

# Test databases
test_*.db
test_*.sqlite

# ===========================================
# IDE & Editor
# ===========================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===========================================
# Temporary Files
# ===========================================
*.tmp
*.temp
*.bak
.tmp/
temp/

# SQL query scratch files
scratch.sql
test-query.sql
temp-*.sql

# ===========================================
# Documentation Build
# ===========================================
docs/_build/
docs/generated/

# ===========================================
# Project Specific
# ===========================================
# Development database states
_dev/init-done.flag
_dev/setup-complete.flag

# Local utility scripts
local-*.sh
local-*.py
test-connection.py
quick-test.sql

# Performance profiling
*.prof
*.lprof

# Archives
*.zip
*.tar
*.tar.gz
*.rar

# Old versions / deprecated
deprecated/
old/
archive/

# ===========================================
# Security & Credentials
# ===========================================
# Never commit these
credentials.json
secrets.json
*.pem
*.key
*.cert

# Admin passwords
admin-password.txt
root-password.txt