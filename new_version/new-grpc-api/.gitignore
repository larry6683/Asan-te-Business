*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# ===========================================
# Generated Protobuf Code
# ===========================================
# Generated Python protobuf files
src/codegen/**/*_pb2.py
src/codegen/**/*_pb2_grpc.py
src/codegen/**/*_pb2.pyi

# Keep __init__.py files
!src/codegen/**/__init__.py

# Keep proto definitions
!src/protos/**/*.proto

# Keep generation scripts
!scripts/generate-proto.sh
!scripts/generate-proto.ps1
!fix_imports.py

# ===========================================
# Configuration & Secrets
# ===========================================
# Environment files
.env
.env.local
.env.*.local
*.env

# Configuration files (keep template)
src/config/*.json
!src/config/*.template.json
appsettings.json
appsettings.*.json
!appsettings.template.json

# Database credentials
database.json
db-config.json

# AWS credentials
aws-credentials.json
cognito-config.json

