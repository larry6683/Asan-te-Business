# ============================================
# ASANTe Platform - Root .gitignore
# ============================================

# ===========================================
# Environment & Configuration Files
# ===========================================
.env
.env.local
.env.development
.env.test
.env.production
*.env

# AWS Cognito credentials
**/config/cognito.json
**/config/aws-config.json

# Database credentials
**/config/database.json
**/_dev/.env

# API Configuration
**/appsettings.json
**/appsettings.*.json
!**/appsettings.template.json

# ===========================================
# Operating System Files
# ===========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ===========================================
# IDE & Editor Files
# ===========================================
# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace
.history/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
tags
[._]*.un~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# JetBrains
.idea/
*.iml
*.ipr
*.iws

# ===========================================
# Build Artifacts & Dependencies
# ===========================================
# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.npm
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.pytest_cache/
.pytype/
.mypy_cache/
.dmypy.json
dmypy.json

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
pythonenv*/

# ===========================================
# Docker & Containers
# ===========================================
docker-compose.override.yml
.docker/

# ===========================================
# Database Files
# ===========================================
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.sql.backup

# ===========================================
# Logs & Temp Files
# ===========================================
logs/
*.log
*.log.*
*.tmp
*.temp
*.swp
*.swo
*.bak
*.backup
*~

# ===========================================
# Generated Code & Proto Files
# ===========================================
# Keep proto definitions but ignore generated code
*_pb2.py
*_pb2_grpc.py
*_pb2_pyi
*_pb.js
*_grpc_web_pb.js

# Keep generation scripts
!generate-proto.sh
!generate-proto.ps1

# ===========================================
# Test & Coverage
# ===========================================
.pytest_cache/
.coverage
.nyc_output
coverage/
test-results/
*.cover
htmlcov/

# ===========================================
# Security & Sensitive Data
# ===========================================
# Never commit credentials
**/credentials.json
**/secrets.json
**/.secrets
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
id_rsa*
known_hosts

# ===========================================
# Misc
# ===========================================
# Compressed files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Archives
*.zip
*.tar.gz
*.rar
*.7z

# Package files
*.pkg
*.deb
*.rpm

# ===========================================
# Project Specific
# ===========================================
# Generated protobuf code (except __init__.py)
**/codegen/**/*_pb2.py
**/codegen/**/*_pb2_grpc.py
!**/codegen/**/__init__.py

# Frontend build
**/build/
**/dist/
**/.cache/

# Backend compiled
**/*.pyc
**/__pycache__/

# Test data
**/test-data/
**/seed-data-backup/

# Temporary scripts
**/temp-*.sh
**/temp-*.py
**/test-*.tmp

# Local configuration overrides
local.settings.json
*.local.json