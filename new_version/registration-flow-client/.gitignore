# ============================================
# React Frontend - .gitignore
# ============================================

# ===========================================
# Environment Variables & Configuration
# ===========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# AWS Cognito Configuration
src/config/cognito.json
src/config/aws-credentials.json

# ===========================================
# Dependencies
# ===========================================
node_modules/
.pnp/
.pnp.js
.yarn/
.yarn-integrity

# Package manager files
package-lock.json
yarn.lock
pnpm-lock.yaml

# ===========================================
# Build Output
# ===========================================
build/
dist/
out/
.next/
.cache/
.parcel-cache/

# ===========================================
# Testing & Coverage
# ===========================================
coverage/
.nyc_output/
*.lcov
test-results/
.jest/

# ===========================================
# Generated Files
# ===========================================
# Generated protobuf code
src/proto/**/*_pb.js
src/proto/**/*_grpc_web_pb.js
# Keep proto definitions
!src/proto/**/*.proto
# Keep generation scripts
!scripts/generate-proto.sh

# Generated service clients
src/api/generated/

# ===========================================
# Logs
# ===========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ===========================================
# Runtime & Cache
# ===========================================
.cache/
.eslintcache
.stylelintcache
.node_repl_history
*.tgz

# ===========================================
# IDE & Editor
# ===========================================
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store

# ===========================================
# Misc
# ===========================================
# Archives
*.zip
*.tar.gz
*.rar

# Temporary files
*.tmp
*.temp
.tmp/

# Debug
.vscode/launch.json
debug.log

# Optional
.env.backup
.env.example.backup